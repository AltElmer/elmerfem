Check Keywords "Warn"

Header
  Mesh DB "." "square"
End

Simulation
  Coordinate System = "Cartesian"
  Simulation Type = Steady State
  Steady State Max Iterations = 1

  Max Output Level = 5
End

Body 1
  Equation = 1
  Material = 1
  Initial Condition = 1
End

Initial Condition 1
  Potential Velocity = Real 1
End

Material 1
  Name = "Ideal"
  Sound Speed = 1.0
  Density = 1.0
  Sound Damping = 0.01
End 

Equation 1
  Active Solvers(1) = 1
End

Solver 1
  Equation = "WaveEq"

  Variable = "Potential"
  Variable DOFs = 1
!  Procedure = "WaveEq" "WaveSolver"
  Procedure = "WaveSolver" "WaveSolver"

  Steady State Convergence Tolerance = 1e-09

  Linear System Solver = "Direct"
  Linear System Direct Method = Umfpack

  Eigen System Select = smallest imag part

! For visualization purposes make amplitude one for all
!  Eigen System Normalize To Unity = Logical True

  Eigen Analysis = True
  Eigen System Damped = True
  Eigen System Values = 10
  Eigen System Convergence Tolerance = 0
End

Solver 2
!  Exec Solver = never
  Equation = "result output"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = case
  Vtu Format = Logical True
  Single Precision = Logical True 

  Eigen Analysis = True
End


Solver 3
  Equation = "SaveScalars"
!  Filename = f.dat

  Procedure = "SaveData" "SaveScalars"
  Save EigenValues = True

! Compare the norm of the 10th eigenvalue
  Show Norm Index = 10 
End


Boundary Condition 1
  Target Boundaries(4) = 1 2 3 4
  Potential = Real 0
!  Potential Velocity = Real 0
End

Solver 3 :: Reference Norm = 4.949379333969E-001

! The reference norm above was recorded against the UMFPACK 4.4 that Elmer
! used to carry. With SuiteSparse's UMFPACK the tenth eigenvalue comes out as
! 4.949462885133E-001, a relative difference of 1.7e-5, which is over the
! default tolerance of 1e-5 and was the only test in the suite to notice the
! change.
!
! The two agree to five significant figures, and the eigenvalue is not
! recomputed from the matrix here: this is a damped, and so quadratic,
! eigenvalue problem, solved by shift-and-invert Arnoldi through whichever
! direct solver is configured. A different factorisation perturbs the operator
! ARPACK iterates on, and eigenvalues 9 and 10 are a degenerate pair, which is
! the arrangement where that perturbation shows up soonest. So the difference
! is round-off travelling through the iteration rather than a different answer.
!
! 1e-4 still requires four significant figures and would catch any real
! regression here; it is the tolerance about a hundred other tests in this
! suite already use.
Solver 3 :: Reference Norm Tolerance = Real 1e-4
